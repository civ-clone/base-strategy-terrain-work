{
  "name": "@civ-clone/base-strategy-terrain-work",
  "version": "0.1.1",
  "description": "Workers improving the terrain around a player's cities, as the computer players do it and as a standing order for a player's unit.",
  "main": "index.js",
  "repository": "git@github.com:civ-clone/base-strategy-terrain-work.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/civ1-unit": "github:civ-clone/civ1-unit",
    "@civ-clone/civ1-world": "github:civ-clone/civ1-world",
    "@civ-clone/core-game": "^0.1.1",
    "@civ-clone/core-player-world": "^0.1.0",
    "@civ-clone/core-rule": "^0.1.0",
    "@civ-clone/simple-world-generator": "github:civ-clone/simple-world-generator",
    "@civ-clone/simple-world-path": "github:civ-clone/simple-world-path",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/base-strategy-ai": "^0.1.0",
    "@civ-clone/base-unit-type-worker": "^0.1.0",
    "@civ-clone/core-city": "^0.1.0",
    "@civ-clone/core-player": "^0.1.0",
    "@civ-clone/core-science": "^0.1.0",
    "@civ-clone/core-unit": "^0.1.0",
    "@civ-clone/core-world": "^0.1.0",
    "@civ-clone/core-world-path": "^0.1.0"
